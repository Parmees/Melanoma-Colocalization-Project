safe_dir <- function(path) {
  dir.create(path, recursive = TRUE, showWarnings = FALSE)
  invisible(path)
}

one_sided_p <- function(z, p_two_sided, alternative = c("greater", "less")) {
  alternative <- match.arg(alternative)
  # "greater" means z > 0 is evidence; "less" means z < 0 is evidence
  if (is.na(z) || is.na(p_two_sided)) return(NA_real_)
  if (alternative == "greater") {
    if (z >= 0) return(p_two_sided / 2) else return(1)
  } else {
    if (z <= 0) return(p_two_sided / 2) else return(1)
  }
}

